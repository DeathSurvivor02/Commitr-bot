# Discord Webhook URL (Required for sending reports to Discord)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Directories to monitor for code edits (Comma-separated list, defaults to current directory)
WATCH_DIRECTORIES=.

# Scheduled daily dispatch time in HH:MM format (24-hour time, e.g., 18:00 for 6 PM)
DISPATCH_TIME=18:00

# Idle timeout threshold in minutes (Gaps longer than this don't count toward active time)
IDLE_TIMEOUT_MINUTES=10
